import glob
import json
import os
import re
import requests

# ফায়ারবেস কনফিগারেশন
FIREBASE_URL = "https://fusion-sports-2c3d2-default-rtdb.firebaseio.com/"
FIREBASE_SECRET = "uogZkbCFyw8CHBurNCZWUeakOOshWKbHf2XlxWKR"  # <--- আপনার ফায়ারবেস সিক্রেট কি এখানে বসাবেন


def slugify(text):
    if not text:
        return "unknown-slug"
    text = text.lower().strip()
    text = re.sub(r"[^\w\s-]", "", text)
    text = re.sub(r"[\s_-]+", "-", text)
    return text.strip("-")


def upload_matches_to_firebase():
    all_matches = []
    seen_titles = set()

    # ১. সকল page_*.json ফাইল থেকে ৪,৫৩৬টি ম্যাচের ডাটা সংগ্রহ করা
    page_files = sorted(glob.glob("page_*.json"))

    if not page_files and os.path.exists("refooty.json"):
        page_files = ["refooty.json"]

    if not page_files:
        print("[!] কোনো জেসন বা পেজ ফাইল পাওয়া যায়নি!")
        return

    print(f"[-] মোট {len(page_files)} টি ফাইল থেকে ডাটা রিড করা হচ্ছে...")

    for pf in page_files:
        try:
            with open(pf, "r", encoding="utf-8") as f:
                content = json.load(f)
                matches = content.get("matches", [])
                if not matches and "latest_matches" in content:
                    matches = content.get("latest_matches", [])

                for m in matches:
                    t = m.get("title")
                    if t and t not in seen_titles:
                        seen_titles.add(t)
                        all_matches.append(m)
        except Exception as e:
            print(f"[!] {pf} ফাইল পড়তে সমস্যা: {e}")

    total_count = len(all_matches)
    print(f"[+] সর্বমোট {total_count} টি অনন্য ম্যাচ একত্রিত হয়েছে।")

    if total_count == 0:
        print("[!] কোনো ম্যাচ পাওয়া যায়নি। আপলোড বাতিল করা হলো।")
        return

    # ২. ডাটাবেজের 'Highlights/matches' নোডের জন্য ডিকশনারি সাজানো
    print(
        "\n[-] ফায়ারবেস ডাটাবেজের 'Highlights' নোডে আপলোডের জন্য ডাটা তৈরি হচ্ছে..."
    )
    firebase_payload = {}

    for m in all_matches:
        title = m.get("title", "")
        slug = slugify(title)
        if slug:
            firebase_payload[slug] = m

    # ৩. ডাটাবেজে নিরাপদভাবে PATCH রিকোয়েস্ট পাঠানো (অন্যান্য নোড নিরাপদ রাখতে)
    target_endpoint = (
        f"{FIREBASE_URL.rstrip('/')}/Highlights/matches.json?auth={FIREBASE_SECRET}"
    )

    print(
        f"[-] ফায়ারবেস ডাটাবেজে {len(firebase_payload)} টি ম্যাচ আপলোড করা হচ্ছে..."
    )

    try:
        # ৫০০টি করে ব্যাচে ভাগ করে দ্রুত ও নিরাপদ আপলোড
        items = list(firebase_payload.items())
        batch_size = 500
        total_batches = (len(items) + batch_size - 1) // batch_size

        for i in range(total_batches):
            batch_dict = dict(items[i * batch_size : (i + 1) * batch_size])
            res = requests.patch(
                target_endpoint,
                data=json.dumps(batch_dict, ensure_ascii=False),
                headers={"Content-Type": "application/json"},
                timeout=30,
            )

            if res.status_code == 200:
                print(
                    f"  [✓] ব্যাচ {i+1}/{total_batches} আপলোড সফল ({len(batch_dict)} টি ম্যাচ)"
                )
            else:
                print(
                    f"  [!] ব্যাচ {i+1} আপলোডে সমস্যা, রেসপন্স কোড: {res.status_code}"
                )

        print("\n==========================================")
        print(
            f" [SUCCESS] ১০০% সফলতা! সম্পূর্ণ {total_count} টি ম্যাচ 'Highlights' নোডে সেভ হয়ে গেছে!"
        )
        print("==========================================")

    except Exception as e:
        print(f"\n[ERROR] ফায়ারবেসে আপলোড করার সময় সমস্যা: {e}")


if __name__ == "__main__":
    upload_matches_to_firebase()
